# =============================================================================
# BLACKBOX — Supabase / Vercel
# Local: copy to `.env` and `.env.local`
# Production: set the same keys in Vercel → Project → Settings → Environment Variables
# =============================================================================

# App client (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server uploads (Project Settings → API → service_role) — required on Vercel
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — use SHARED POOLER (IPv4). Direct db.*.supabase.co is IPv6-only.
# Transaction pooler (runtime):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migrations / Prisma directUrl):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth — on Vercel use your production URL, e.g. https://blackbox-claims.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Policy AI extraction (Coverage Protocol → Parse Policy)
# Get a key at https://console.anthropic.com — put the real key ONLY in .env and .env.local
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
# ANTHROPIC_POLICY_MODEL=claude-sonnet-4-6

UPLOAD_DIR="public/uploads"

# Optional: serve claim docs via time-limited signed URLs (needs private bucket + service role)
# STORAGE_USE_SIGNED_URLS=1

# Seed is destructive — never run against production without this flag
# ALLOW_DESTRUCTIVE_SEED=1
